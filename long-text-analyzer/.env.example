# 用哪个 provider 就填哪个 key，不用全填。
OPENAI_API_KEY=replace-with-your-key
ANTHROPIC_API_KEY=replace-with-your-key
DEEPSEEK_API_KEY=replace-with-your-key
GOOGLE_API_KEY=replace-with-your-key
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_MODEL_DEPLOYMENT=your-deployment-name

# web_analyzer.py 默认走哪个 provider
DEFAULT_LLM_PROVIDER=anthropic

# Flask session 用的密钥，随便填一串随机字符串
FLASK_SECRET_KEY=replace-with-a-random-string
